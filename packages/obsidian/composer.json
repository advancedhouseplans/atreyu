{
    "name": "ahp/obsidian",
    "type": "library",
    "description": "Obsidian design system: Blade and Alpine component library",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "illuminate/support": "^13.0",
        "illuminate/view": "^13.0",
        "livewire/livewire": "^4.0",
        "blade-ui-kit/blade-heroicons": "^2.7",
        "livewire/blaze": "^1.0"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "Obsidian\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Obsidian\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Obsidian\\ObsidianServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
