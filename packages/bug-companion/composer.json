{
    "name": "ahp/bug-companion",
    "type": "library",
    "description": "Laravel telemetry and report companion for Atreyu",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "illuminate/support": "^11.0 || ^12.0 || ^13.0",
        "illuminate/http": "^11.0 || ^12.0 || ^13.0",
        "illuminate/routing": "^11.0 || ^12.0 || ^13.0",
        "illuminate/cache": "^11.0 || ^12.0 || ^13.0",
        "illuminate/database": "^11.0 || ^12.0 || ^13.0",
        "illuminate/log": "^11.0 || ^12.0 || ^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "BugCompanion\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BugCompanion\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": ["BugCompanion\\BugCompanionServiceProvider"]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
